rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasProfile()
        && currentProfile().role == "admin";
    }

    function isApprovedReviewer() {
      return hasProfile()
        && currentProfile().role == "reviewer"
        && currentProfile().status == "approved";
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "displayName", "email", "role", "status", "createdAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "reviewer"
        && request.resource.data.status == "pending";

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if signedIn()
        && (isAdmin() || isApprovedReviewer())
        && request.resource.data.keys().hasOnly([
          "episodeId", "score", "reason", "displayName", "updatedAt"
        ])
        && request.resource.data.episodeId is string
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 6
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 800
        && request.resource.data.displayName is string
        && request.resource.data.displayName == currentProfile().displayName
        && ratingId == request.resource.data.episodeId + "_" + request.auth.uid;

      allow update: if signedIn()
        && (isAdmin() || isApprovedReviewer())
        && request.resource.data.keys().hasOnly([
          "episodeId", "score", "reason", "displayName", "updatedAt"
        ])
        && request.resource.data.episodeId == resource.data.episodeId
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 6
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 800
        && request.resource.data.displayName is string
        && request.resource.data.displayName == currentProfile().displayName
        && ratingId == resource.data.episodeId + "_" + request.auth.uid;

      allow delete: if isAdmin();
    }
  }
}
